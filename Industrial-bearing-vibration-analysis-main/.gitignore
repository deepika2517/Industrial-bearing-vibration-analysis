# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/secrets.toml

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Project generated artifacts (keep the folders, ignore heavy outputs)
results/*.png
results/*.csv
results/*.pdf
!results/.gitkeep

# Large raw datasets (keep instructions + small samples)
data/raw/
data/*.mat
data/*.csv
!data/samples/*.csv

# Scratch downloads / Kaggle copies
raw data/
*.npz
